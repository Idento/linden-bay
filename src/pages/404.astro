---
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
---

<Base title="Page not found | Linden Bay" description="This page does not exist." noindex>
  <main class="not-found wrap" id="content">
    <p class="eyebrow">404</p>
    <h1 class="h2">This path ends at the cliff edge.</h1>
    <p>The page you are looking for does not exist.</p>
    <a class="btn btn--outline" href={`${base}/`}>Back to Linden Bay</a>
  </main>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-block: 120px;
  }

  .not-found p:not(.eyebrow) {
    color: var(--muted);
  }
</style>
